# Single source of truth for pinned tool versions.
# Read by scripts/build-site.sh (sourced) and by .github/workflows/site.yml
# (appended to $GITHUB_ENV). Plain KEY=VALUE lines only: no quotes, no spaces.
#
# Bumping Quartz: see site/README.md ("Bumping the Quartz version").

# Quartz release tag (v4 line; v5 uses a different YAML config and is not supported here).
QUARTZ_TAG=v4.5.2
# Commit the tag must resolve to; the build aborts if the clone does not match,
# so a moved tag cannot silently change the build. (`git ls-remote <repo> 'refs/tags/<tag>^{}'`)
QUARTZ_COMMIT=4923affa7722dfc751f1074348e6dad214fe0c08

# Node.js used by CI. Quartz v4.5.2 requires node >=22 and npm >=10.9.2 (its package.json "engines").
NODE_VERSION=22.23.3
